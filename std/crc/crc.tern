package std::crc

// std::crc — cyclic redundancy checks and scramblers.
//
// CRC parameters follow the Rocksoft model ("A painless guide to CRC
// error detection algorithms"): width W, polynomial Poly (without the x^W
// term, normal MSB-first notation), initial register value Init, input
// reflection RefIn, output reflection RefOut and final XorOut. Every preset
// below states its standard check value: the CRC of the ASCII string
// "123456789".
//
// Parallelism comes from the payload type: Crc<u8, ..> consumes a byte per
// cycle, Crc<u32, ..> a 32-bit word per cycle (word-parallel), Crc<bool, ..>
// one bit per cycle. The update is an unrolled XOR network that synthesis
// flattens to the usual parallel CRC matrix.
//
// Byte order of wide words: a word whose width is a multiple of 8 is a
// little-endian sequence of bytes (bits [7:0] first, as produced by
// std::stream::Gearbox). Within each byte, bits are taken LSB first when
// RefIn is set and MSB first otherwise. Words narrower than 8 bits are
// taken LSB first (RefIn) or MSB first (not RefIn) as a whole.

use std::math::reverse_bits

/// Maximal-length LFSR, re-exported from `std::math`.
pub use std::math::Lfsr

// ---------------------------------------------------------------------------
// Update function
// ---------------------------------------------------------------------------

/// Advance a CRC register (in normal, unreflected orientation) over the
/// data word `d`, following the bit order described in the package notes.
/// Call as `crc_update<Poly, RefIn>(state, bits(word))`. Usable on signals
/// (an XOR network) and at compile time.
pub const fn crc_update<Poly: uint, RefIn: bool>(c: bit<W>, d: bit<DW>) -> bit<W> {
    let p = Poly as bit<W>
    var x: bit<W> = c
    if DW >= 8 {
        static_assert((DW / 8) * 8 == DW, "crc: data width must be a multiple of 8, or below 8")
        for k in 0..(DW / 8) {
            for j in 0..8 {
                let i = if RefIn { j } else { 7 - j }
                let fb = x[W - 1] != d[8 * k + i]
                x = if fb { (x << 1) ^ p } else { x << 1 }
            }
        }
    } else {
        for j in 0..DW {
            let i = if RefIn { j } else { DW - 1 - j }
            let fb = x[W - 1] != d[i]
            x = if fb { (x << 1) ^ p } else { x << 1 }
        }
    }
    x
}

// ---------------------------------------------------------------------------
// Crc
// ---------------------------------------------------------------------------

/// Generic CRC engine. A sink: it accepts one word of `T` per cycle
/// (`in.ready` is always high) and `crc` shows the finished CRC (reflected
/// and XORed as the parameters say) of every word since the last `clear` or
/// reset, one cycle after the last word. `clear` together with a word
/// starts a new message with that word.
pub module Crc<T: type, W: uint, Poly: uint, Init: uint, RefIn: bool, RefOut: bool, XorOut: uint>
where W >= 1, Poly < (1 << W), Init < (1 << W), XorOut < (1 << W)
{
    /// Clock.
    in clk: clock
    /// Reset; starts a new message.
    in rst: reset
    /// Message words. Always ready.
    in in: Stream<T>
    /// Start a new message (with the word on `in`, if any).
    in clear: bool
    /// The finished CRC of the message so far.
    out crc: uint<W>
    /// The raw CRC register (unreflected, before XorOut), for chaining.
    out state: bit<W>

    /// Cycles from the last word to its `crc`.
    pub const LATENCY: uint = 1

    const INIT: bit<W> = Init as bit<W>

    reg r: bit<W> = INIT

    in.ready = true
    let base = if clear { INIT } else { r }

    on clk {
        if in.fire() {
            r = crc_update<Poly, RefIn>(base, bits(in.data))
        } else if clear {
            r = INIT
        }
    }

    let fin = if RefOut { reverse_bits(r) } else { r }
    crc = (fin ^ (XorOut as bit<W>)) as uint<W>
    state = r

    /// The register only changes on a word or a clear.
    property holds_when_idle {
        always (!in.fire() and !clear) |=> stable(r)
    }

    /// A clear without a word restarts at Init.
    property clear_restarts {
        always (clear and !in.fire()) |=> r == INIT
    }
}

// ---------------------------------------------------------------------------
// Presets
// ---------------------------------------------------------------------------

/// CRC-8 (SMBus): poly 0x07, init 0x00, no reflection, xorout 0x00.
/// Check value 0xF4.
pub module Crc8<T: type = u8> {
    /// Clock.
    in clk: clock
    /// Reset; starts a new message.
    in rst: reset
    /// Message words. Always ready.
    in in: Stream<T>
    /// Start a new message (with the word on `in`, if any).
    in clear: bool
    /// The finished CRC of the message so far.
    out crc: u8

    /// Cycles from the last word to its `crc`.
    pub const LATENCY: uint = 1
    /// CRC of "123456789".
    pub const CHECK: uint = 0xF4

    let c = Crc<T, 8, 0x07, 0x00, false, false, 0x00>(in: in, clear: clear)
    crc = c.crc
}

/// CRC-16/CCITT-FALSE (also IBM-3740): poly 0x1021, init 0xFFFF, no
/// reflection, xorout 0x0000. Check value 0x29B1.
pub module Crc16Ccitt<T: type = u8> {
    /// Clock.
    in clk: clock
    /// Reset; starts a new message.
    in rst: reset
    /// Message words. Always ready.
    in in: Stream<T>
    /// Start a new message (with the word on `in`, if any).
    in clear: bool
    /// The finished CRC of the message so far.
    out crc: u16

    /// Cycles from the last word to its `crc`.
    pub const LATENCY: uint = 1
    /// CRC of "123456789".
    pub const CHECK: uint = 0x29B1

    let c = Crc<T, 16, 0x1021, 0xFFFF, false, false, 0x0000>(in: in, clear: clear)
    crc = c.crc
}

/// CRC-16/MODBUS: poly 0x8005, init 0xFFFF, reflected in and out, xorout
/// 0x0000. Check value 0x4B37.
pub module Crc16Modbus<T: type = u8> {
    /// Clock.
    in clk: clock
    /// Reset; starts a new message.
    in rst: reset
    /// Message words. Always ready.
    in in: Stream<T>
    /// Start a new message (with the word on `in`, if any).
    in clear: bool
    /// The finished CRC of the message so far.
    out crc: u16

    /// Cycles from the last word to its `crc`.
    pub const LATENCY: uint = 1
    /// CRC of "123456789".
    pub const CHECK: uint = 0x4B37

    let c = Crc<T, 16, 0x8005, 0xFFFF, true, true, 0x0000>(in: in, clear: clear)
    crc = c.crc
}

/// CRC-32 (Ethernet, zlib, PNG): poly 0x04C11DB7, init 0xFFFFFFFF, reflected
/// in and out, xorout 0xFFFFFFFF. Check value 0xCBF43926.
pub module Crc32<T: type = u8> {
    /// Clock.
    in clk: clock
    /// Reset; starts a new message.
    in rst: reset
    /// Message words. Always ready.
    in in: Stream<T>
    /// Start a new message (with the word on `in`, if any).
    in clear: bool
    /// The finished CRC of the message so far.
    out crc: u32

    /// Cycles from the last word to its `crc`.
    pub const LATENCY: uint = 1
    /// CRC of "123456789".
    pub const CHECK: uint = 0xCBF4_3926

    let c = Crc<T, 32, 0x04C1_1DB7, 0xFFFF_FFFF, true, true, 0xFFFF_FFFF>(in: in, clear: clear)
    crc = c.crc
}

/// CRC-32C (Castagnoli; iSCSI, SCTP, ext4): poly 0x1EDC6F41, init
/// 0xFFFFFFFF, reflected in and out, xorout 0xFFFFFFFF. Check value
/// 0xE3069283.
pub module Crc32C<T: type = u8> {
    /// Clock.
    in clk: clock
    /// Reset; starts a new message.
    in rst: reset
    /// Message words. Always ready.
    in in: Stream<T>
    /// Start a new message (with the word on `in`, if any).
    in clear: bool
    /// The finished CRC of the message so far.
    out crc: u32

    /// Cycles from the last word to its `crc`.
    pub const LATENCY: uint = 1
    /// CRC of "123456789".
    pub const CHECK: uint = 0xE306_9283

    let c = Crc<T, 32, 0x1EDC_6F41, 0xFFFF_FFFF, true, true, 0xFFFF_FFFF>(in: in, clear: clear)
    crc = c.crc
}

// The ASCII string "123456789" used by every check value.
const CHECK_MSG: [u8; 9] = [0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39]

test "crc-32 check value" {
    let dut = sim Crc32()
    dut.reset()
    dut.clear = false
    for b in CHECK_MSG {
        dut.in = Stream { valid: true, data: b }
        dut.settle()
        expect dut.in.ready
        dut.step()
    }
    dut.in.valid = false
    dut.settle()
    expect dut.crc == 0xCBF4_3926
}

test "crc-32c check value" {
    let dut = sim Crc32C()
    dut.reset()
    dut.clear = false
    for b in CHECK_MSG {
        dut.in = Stream { valid: true, data: b }
        dut.step()
    }
    dut.in.valid = false
    dut.settle()
    expect dut.crc == 0xE306_9283
}

test "crc-16/ccitt-false check value" {
    let dut = sim Crc16Ccitt()
    dut.reset()
    dut.clear = false
    for b in CHECK_MSG {
        dut.in = Stream { valid: true, data: b }
        dut.step()
    }
    dut.in.valid = false
    dut.settle()
    expect dut.crc == 0x29B1
}

test "crc-16/modbus check value" {
    let dut = sim Crc16Modbus()
    dut.reset()
    dut.clear = false
    for b in CHECK_MSG {
        dut.in = Stream { valid: true, data: b }
        dut.step()
    }
    dut.in.valid = false
    dut.settle()
    expect dut.crc == 0x4B37
}

test "crc-8 check value" {
    let dut = sim Crc8()
    dut.reset()
    dut.clear = false
    for b in CHECK_MSG {
        dut.in = Stream { valid: true, data: b }
        dut.step()
    }
    dut.in.valid = false
    dut.settle()
    expect dut.crc == 0xF4
}

test "crc-32 word-parallel matches byte-serial" {
    // "12345678" as two little-endian 32-bit words
    let dut = sim Crc32<u32>()
    dut.reset()
    dut.clear = false
    for w in [0x3433_3231, 0x3837_3635] {
        dut.in = Stream { valid: true, data: w }
        dut.step()
    }
    dut.in.valid = false
    dut.settle()
    expect dut.crc == 0x9AE0_DAAF
}

test "crc-16/ccitt word-parallel matches byte-serial" {
    let dut = sim Crc16Ccitt<u16>()
    dut.reset()
    dut.clear = false
    for w in [0x3231, 0x3433, 0x3635, 0x3837] {
        dut.in = Stream { valid: true, data: w }
        dut.step()
    }
    dut.in.valid = false
    dut.settle()
    expect dut.crc == 0xA12B
}

test "crc-8 bit-serial (MSB first) check value" {
    let dut = sim Crc<bool, 8, 0x07, 0x00, false, false, 0x00>()
    dut.reset()
    dut.clear = false
    for b in CHECK_MSG {
        for j in 0..8 {
            dut.in = Stream { valid: true, data: bits(b)[7 - j] }
            dut.step()
        }
    }
    dut.in.valid = false
    dut.settle()
    expect dut.crc == 0xF4
}

test "crc: clear restarts, idle cycles do not change the crc" {
    let dut = sim Crc32()
    dut.reset()
    dut.clear = false
    dut.in = Stream { valid: true, data: 0xFF }
    dut.step(3)                    // some garbage
    dut.clear = true
    dut.in = Stream { valid: true, data: CHECK_MSG[0] }
    dut.step()                     // clear together with the first byte
    dut.clear = false
    for i in 1..9 {
        dut.in = Stream { valid: true, data: CHECK_MSG[i] }
        dut.step()
        dut.in.valid = false
        dut.step(2)                // gaps between bytes
    }
    expect dut.crc == 0xCBF4_3926
}

test "crc_update at compile time" {
    var c: bit<32> = all1
    for b in CHECK_MSG {
        c = crc_update<0x04C1_1DB7, true>(c, bits(b))
    }
    expect (reverse_bits(c) ^ 0xFFFF_FFFF) == 0xCBF4_3926
}

// ---------------------------------------------------------------------------
// Scrambler
// ---------------------------------------------------------------------------

/// Multiplicative (self-synchronizing) scrambler / descrambler over a
/// stream, `T::WIDTH` bits per beat, bit 0 first. Each output bit is the
/// input bit XORed with the tapped history bits; the scrambler's history is
/// its own output, the descrambler's (`Descramble = true`) is its input, so
/// a descrambler locks to any scrambler after W bits regardless of the
/// starting states. Taps use the `lfsr_taps` convention (bit k-1 set for
/// x^k). The default is the 64b/66b scrambler x^58 + x^39 + 1.
pub module Scrambler<T: type, W: uint = 58, Taps: uint = 0x0200_0040_0000_0000, Descramble: bool = false>
where W >= 2, Taps < (1 << W), (Taps >> (W - 1)) == 1
{
    /// Clock.
    in clk: clock
    /// Reset; loads the all-ones history.
    in rst: reset
    /// Data to (de)scramble.
    in in: Stream<T>
    /// (De)scrambled data, same handshake (combinational).
    out out: Stream<T>

    /// Added latency in cycles.
    pub const LATENCY: uint = 0

    const DW: uint = T::WIDTH
    const P: bit<W> = Taps as bit<W>

    struct Step {
        data: bit<DW>,
        hist: bit<W>,
    }

    fn run(d: bit<DW>, h: bit<W>) -> Step {
        var x: bit<W> = h
        var o: bit<DW> = all0
        for i in 0..DW {
            let ob = d[i] != ^(x & P)
            o[i] = ob
            let shift_in = if Descramble { d[i] } else { ob }
            x = x[W - 2:0] ++ (shift_in as uint<1>)
        }
        Step { data: o, hist: x }
    }

    reg hist: bit<W> = all1
    let r = run(bits(in.data), hist)

    out.valid = in.valid
    out.data = T::from_bits(r.data)
    in.ready = out.ready

    on clk {
        if in.fire() { hist = r.hist }
    }

    /// The history only advances with data.
    property holds_when_idle {
        always !in.fire() |=> stable(hist)
    }
}

test "scrambler: descrambler recovers the data" {
    let scr = sim Scrambler<u32>()
    let des = sim Scrambler<u32, Descramble: true>()
    scr.reset()
    des.reset()
    scr.out.ready = true
    des.out.ready = true
    var changed: bool = false
    for _ in 0..200 {
        let w = rand<u32>()
        scr.in = Stream { valid: true, data: w }
        scr.settle()
        if scr.out.data != w { changed = true }
        des.in = Stream { valid: true, data: scr.out.data }
        des.settle()
        expect des.out.valid and des.out.data == w
        scr.step()
        des.step()
    }
    expect changed
}

test "scrambler: descrambler self-synchronizes" {
    let scr = sim Scrambler<u8, 7, 0x60>()                       // x^7 + x^6 + 1
    let des = sim Scrambler<u8, 7, 0x60, Descramble: true>()
    scr.reset()
    des.reset()
    scr.out.ready = true
    des.out.ready = true
    // push the scrambler away from the descrambler's starting state
    for b in [0x00, 0x13, 0x57, 0x9B] {
        scr.in = Stream { valid: true, data: b }
        scr.step()
    }
    for i in 0..20 {
        let w = rand<u8>()
        scr.in = Stream { valid: true, data: w }
        scr.settle()
        des.in = Stream { valid: true, data: scr.out.data }
        des.settle()
        if i >= 1 {                  // 8 bits per beat > 7 history bits
            expect des.out.data == w
        }
        scr.step()
        des.step()
    }
}

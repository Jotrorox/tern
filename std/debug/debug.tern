package std::debug

// std::debug — on-chip debugging aids: Ila (integrated logic analyzer),
// Heartbeat (alive LED) and ErrorLatch (sticky error flags).
//
// The #[probe] attribute on a signal (handled by the compiler) routes it to
// an Ila without touching the design's ports; the Ila below is the capture
// engine it instantiates, and can also be instantiated by hand.

use std::stream::Beat
use std::math::priority_encode

// ---------------------------------------------------------------------------
// Ila
// ---------------------------------------------------------------------------

/// Integrated logic analyzer: a trigger-and-capture engine for a probe
/// word of any type. After `arm` it records `probes` every cycle into a
/// circular buffer; once at least `Pre` samples are recorded, the first
/// cycle with `trigger` freezes a window of `Depth` samples: `Pre` before
/// the trigger cycle, the trigger cycle itself and `Depth - Pre - 1` after.
/// The window is then streamed out on `out`, oldest sample first, `last` on
/// the final one, after which the Ila is idle until armed again. Connect
/// `out` through a Gearbox to a UART transmitter or an AXI-Stream / register
/// interface to read it out.
pub module Ila<T: type, Depth: uint = 1024, Pre: uint = Depth / 2>
where Depth.is_pow2(), Depth >= 2, Pre < Depth
{
    /// Clock.
    in clk: clock
    /// Reset; the Ila goes idle.
    in rst: reset
    /// The signals to record.
    in probes: T
    /// Trigger condition (accepted once `Pre` samples are recorded).
    in trigger: bool
    /// Start recording and wait for a trigger.
    in arm: bool
    /// The captured window, oldest sample first.
    out out: Stream<Beat<T>>
    /// Recording, waiting for the trigger.
    out armed: bool
    /// Triggered: capturing the rest of the window or reading out.
    out triggered: bool

    /// Cycles from the end of the capture to the first sample on `out`.
    pub const LATENCY: uint = 1

    enum State { Idle, Armed, Capture, Readout }

    type Ptr = uint<clog2(Depth)>
    type Cnt = uint<clog2(Depth + 1)>

    mem buf: [T; Depth]
    reg state: State = .Idle
    reg wp: Ptr = 0
    reg fill: Cnt = 0          // samples recorded while armed (saturates at Pre)
    reg post: Cnt = 0          // samples still to record after the trigger
    reg rp: Ptr = 0
    reg left: Cnt = 0          // samples still to stream out
    reg primed: bool = false   // the read register holds buf[rp]

    let capturing = state == .Armed or state == .Capture
    let rd_addr = if out.fire() { rp +% 1 } else { rp }
    let rdata = buf.read(rd_addr)

    out.valid = state == .Readout and primed
    out.data = Beat { data: rdata, last: left == 1 }
    armed = state == .Armed
    triggered = state == .Capture or state == .Readout

    on clk {
        if capturing {
            buf[wp] = probes
            wp = wp +% 1
        }
        match state {
            .Idle => {
                if arm {
                    state = .Armed
                    fill = 0
                }
            },
            .Armed => {
                if fill == Pre and trigger {
                    if Pre == Depth - 1 {
                        // the trigger sample completes the window
                        state = .Readout
                        rp = wp +% 1
                        left = Depth
                        primed = false
                    } else {
                        state = .Capture
                        post = Depth - Pre - 1
                    }
                } else if fill != Pre {
                    fill = fill +% 1
                }
            },
            .Capture => {
                post = post -% 1
                if post == 1 {
                    state = .Readout
                    rp = wp +% 1     // oldest sample of the window
                    left = Depth
                    primed = false
                }
            },
            .Readout => {
                primed = true
                if out.fire() {
                    rp = rp +% 1
                    left = left -% 1
                    if left == 1 { state = .Idle }
                }
            },
        }
    }

    /// Exactly Depth samples are streamed per capture.
    property readout_bounded {
        always left <= Depth
    }

    /// The buffer is frozen while it is read out.
    property no_capture_during_readout {
        never capturing and out.valid
    }

    /// A stalled sample is held until taken.
    property out_stable {
        always (out.valid and !out.ready) |=> out.valid and stable(out.data)
    }

    cover property triggers { state == .Capture }
}

test "ila: captures the window around the trigger" {
    let dut = sim Ila<u8, 8, 3>()
    dut.reset()
    dut.out.ready = false
    dut.trigger = false
    dut.arm = true
    dut.probes = 0
    dut.step()
    dut.arm = false
    expect dut.armed
    for v in 1..15 {
        dut.probes = v as u8
        dut.trigger = v == 10
        dut.step()
    }
    dut.trigger = false
    expect dut.triggered and !dut.armed
    dut.out.ready = true
    dut.step()                        // prime the read port
    for want in [7, 8, 9, 10, 11, 12, 13, 14] {
        dut.settle()
        expect dut.out.valid and dut.out.data.data == want
        expect dut.out.data.last == (want == 14)
        dut.step()
    }
    expect !dut.out.valid and !dut.triggered and !dut.armed
}

test "ila: trigger is ignored until the pre-trigger window is full" {
    let dut = sim Ila<u8, 4, 2>()
    dut.reset()
    dut.out.ready = false
    dut.arm = true
    dut.trigger = true                // held high from the start
    dut.probes = 0
    dut.step()
    dut.arm = false
    for v in 1..20 {
        dut.probes = v as u8
        dut.step()
    }
    dut.trigger = false
    dut.out.ready = true
    // samples 1, 2 recorded first; 3 is the trigger sample; 4 completes it
    var got: uint = 0
    for _ in 0..10 {
        dut.settle()
        if dut.out.valid {
            expect dut.out.data.data == (got + 1) as u8
            got = got + 1
        }
        dut.step()
    }
    expect got == 4
}

// ---------------------------------------------------------------------------
// Heartbeat
// ---------------------------------------------------------------------------

/// Blinks an LED at `Hz` (50 % duty) from a clock of `ClkHz`: the simplest
/// proof that a bitstream is loaded, the clock runs and reset is released.
pub module Heartbeat<ClkHz: uint, Hz: uint = 1>
where Hz >= 1, ClkHz >= 2 * Hz
{
    /// Clock running at ClkHz.
    in clk: clock
    /// Reset; the LED starts off.
    in rst: reset
    /// The LED.
    out led: bool

    const HALF: uint = ClkHz / (2 * Hz)

    /// Cycles from reset release to the LED first turning on.
    pub const LATENCY: uint = HALF

    reg cnt: uint<clog2(HALF + 1)> = 0
    reg l: bool = false

    on clk {
        if cnt == HALF - 1 {
            cnt = 0
            l = !l
        } else {
            cnt = cnt +% 1
        }
    }

    led = l

    /// The half-period counter stays in range.
    property count_bounded {
        always cnt < HALF
    }

    /// The LED only changes at the end of a half period.
    property toggles_on_wrap {
        always (cnt != HALF - 1) |=> stable(l)
    }
}

test "heartbeat: toggles every half period" {
    let dut = sim Heartbeat<20, 2>()  // half period = 5 cycles
    dut.reset()
    var toggles: uint = 0
    var prev: bool = false
    for _ in 0..50 {
        dut.step()
        if dut.led != prev { toggles = toggles + 1 }
        prev = dut.led
    }
    expect toggles == 10
}

// ---------------------------------------------------------------------------
// ErrorLatch
// ---------------------------------------------------------------------------

/// Sticky error flags: each bit of `errors` that is ever high sets the
/// matching bit of `latched` until `clear`. `first` remembers which error
/// came first since the last clear (lowest index wins a tie). Errors
/// arriving in the same cycle as `clear` are kept, never lost.
pub module ErrorLatch<N: uint = 8>
where N >= 2
{
    /// Clock.
    in clk: clock
    /// Reset; clears every flag.
    in rst: reset
    /// Error pulses or levels.
    in errors: bit<N>
    /// Clear the latched flags.
    in clear: bool
    /// The sticky flags.
    out latched: bit<N>
    /// Any flag is set.
    out any: bool
    /// Index of the first error since the last clear.
    out first: Valid<uint<clog2(N)>>

    /// Cycles from an error to its flag.
    pub const LATENCY: uint = 1

    reg lat: bit<N> = all0
    reg fv: bool = false
    reg fi: uint<clog2(N)> = 0

    let pe = priority_encode(errors)

    on clk {
        if clear {
            lat = errors
            fv = pe.valid
            fi = pe.data
        } else {
            lat = lat | errors
            if !fv and pe.valid {
                fv = true
                fi = pe.data
            }
        }
    }

    latched = lat
    any = |lat
    first.valid = fv
    first.data = fi

    /// Flags never clear by themselves.
    property sticky {
        always !clear |=> (lat & past(lat)) == past(lat)
    }

    /// The first-error record is set exactly when some flag is.
    property first_matches_flags {
        always fv == (lat != all0)
    }
}

test "error latch: sticky flags and first error" {
    let dut = sim ErrorLatch<4>()
    dut.reset()
    dut.clear = false
    dut.errors = 0b0000
    dut.step()
    expect !dut.any and !dut.first.valid
    dut.errors = 0b0100
    dut.step()
    dut.errors = 0b0001
    dut.step()
    dut.errors = 0b0000
    dut.step(3)
    expect dut.latched == 0b0101 and dut.any
    expect dut.first.valid and dut.first.data == 2
    dut.clear = true
    dut.errors = 0b1000                // arrives with the clear: kept
    dut.step()
    dut.clear = false
    dut.errors = 0b0000
    dut.step()
    expect dut.latched == 0b1000 and dut.first.data == 3
}

package std::io

// PS/2 keyboard/mouse port (host side).
//
// CLK and DATA are open-drain: `<line>_oe` pulls the line low, `<line>_i` is
// the pad level (asynchronous). At the #[top] level connect both to `tri<bool>`
// pads with pull-ups. The inputs are synchronised with two flip-flops; CLK is
// additionally glitch-filtered (it must be stable for 4 cycles to change).

/// PS/2 host: receives device-to-host frames and sends host-to-device bytes.
///
/// * Device to host: 11-bit frames (start 0, 8 data bits LSB first, odd
///   parity, stop 1), read on the falling CLK edges. A good frame appears on
///   `out` for one cycle; a frame with a bad start bit, parity or stop bit
///   pulses `error` instead. A frame interrupted for more than 1 ms is
///   discarded so the receiver resynchronises.
/// * Host to device (`in`, accepted between frames): CLK is pulled low for
///   120 us (inhibit), DATA is pulled low (request to send) and CLK released;
///   on each falling CLK edge generated by the device the next bit is put on
///   DATA (8 data bits LSB first, odd parity, stop = released), and the
///   device's ACK (DATA low) is read at the 11th falling edge. `tx_busy` is
///   high meanwhile; afterwards `tx_ack` tells whether the device acknowledged.
///   If the device stops clocking for 20 ms the transfer is abandoned with
///   `tx_ack` low.
/// `ClkHz` defaults to the clock's nominal frequency (`clock_hz(clk)`: the
/// top's `#[clock(hz: ..)]`, passed down through the instances).
pub module Ps2<ClkHz: uint = clock_hz(clk)> {
    /// Clock cycles per microsecond.
    pub const US: uint = ClkHz / 1_000_000
    static_assert(US >= 1, "Ps2 needs a clock of at least 1 MHz")
    const INHIBIT_CYCLES: uint = 120 * US
    const RTS_CYCLES: uint = INHIBIT_CYCLES + 5 * US
    const TIMEOUT_CYCLES: uint = 20_000 * US
    const RX_GAP_CYCLES: uint = 1_000 * US

    /// Clock.
    in clk: clock
    /// Reset.
    in rst: reset
    /// PS/2 CLK level at the pad (asynchronous).
    in ps2_clk_i: bool
    /// PS/2 DATA level at the pad (asynchronous).
    in ps2_data_i: bool
    /// Pull PS/2 CLK low.
    out ps2_clk_oe: bool
    /// Pull PS/2 DATA low.
    out ps2_data_oe: bool
    /// Received bytes (scan codes, mouse packets), valid for one cycle.
    out out: Valid<u8>
    /// Pulses for a received frame with a bad start, parity or stop bit.
    out error: bool
    /// Bytes to send to the device (commands such as 0xFF reset, 0xED LEDs).
    in in: Stream<u8>
    /// A host-to-device transfer is in progress.
    out tx_busy: bool
    /// The device acknowledged the last host-to-device byte.
    out tx_ack: bool

    enum State { Rx, TxInhibit, TxBits, TxAck }

    reg state: State = .Rx
    reg clk_m: bool = true
    reg clk_s: bool = true
    reg data_m: bool = true
    reg data_s: bool = true
    reg clk_hist: bit<4> = 0b1111
    reg clk_f: bool = true
    reg timer: uint<clog2(TIMEOUT_CYCLES + 1)> = 0
    reg rx_sh: bit<11> = 0
    reg rx_cnt: uint<4> = 0
    reg tx_sh: bit<10> = all1
    reg tx_cnt: uint<4> = 0
    reg clk_oe_q: bool = false
    reg data_oe_q: bool = false
    reg out_valid: bool = false
    reg out_data: u8 = 0
    reg err_q: bool = false
    reg ack_q: bool = false

    // filtered CLK is high and has been low for 4 samples: a falling edge now
    let clk_fall = clk_f and clk_hist == 0b0000
    // the frame shifted by the current DATA bit (complete when rx_cnt == 10)
    let frame: bit<11> = (data_s as uint<1>) ++ rx_sh[10:1]
    let frame_ok = !frame[0] and frame[10] and ((^frame[8:1]) != frame[9])
    let timed_out = timer == TIMEOUT_CYCLES - 1

    in.ready = state == .Rx and rx_cnt == 0
    out.valid = out_valid
    out.data = out_data
    error = err_q
    ps2_clk_oe = clk_oe_q
    ps2_data_oe = data_oe_q
    tx_busy = state != .Rx
    tx_ack = ack_q

    on clk {
        clk_m = ps2_clk_i
        clk_s = clk_m
        data_m = ps2_data_i
        data_s = data_m
        clk_hist = clk_hist[2:0] ++ (clk_s as uint<1>)
        if clk_hist == 0b1111 { clk_f = true } else if clk_hist == 0b0000 { clk_f = false }
        out_valid = false
        err_q = false
        match state {
            .Rx => if clk_fall {
                timer = 0
                if rx_cnt == 10 {
                    rx_cnt = 0
                    if frame_ok {
                        out_valid = true
                        out_data = frame[8:1]
                    } else {
                        err_q = true
                    }
                } else {
                    rx_sh = frame
                    rx_cnt = rx_cnt +% 1
                }
            } else if rx_cnt != 0 {
                if timer == RX_GAP_CYCLES - 1 {
                    rx_cnt = 0                                // stale partial frame
                    timer = 0
                } else {
                    timer = timer +% 1
                }
            },
            .TxInhibit => {
                if timer == INHIBIT_CYCLES - 1 { data_oe_q = true }      // request to send
                if timer == RTS_CYCLES - 1 {
                    clk_oe_q = false                                     // the device starts clocking
                    timer = 0
                    tx_cnt = 0
                    state = .TxBits
                } else {
                    timer = timer +% 1
                }
            },
            .TxBits => if clk_fall {
                timer = 0
                data_oe_q = !tx_sh[0]
                tx_sh = tx_sh >> 1
                if tx_cnt == 9 { state = .TxAck } else { tx_cnt = tx_cnt +% 1 }
            } else if timed_out {
                clk_oe_q = false
                data_oe_q = false
                ack_q = false
                timer = 0
                state = .Rx
            } else {
                timer = timer +% 1
            },
            .TxAck => if clk_fall {
                ack_q = !data_s
                timer = 0
                rx_cnt = 0
                state = .Rx
            } else if timed_out {
                data_oe_q = false
                ack_q = false
                timer = 0
                state = .Rx
            } else {
                timer = timer +% 1
            },
        }
        if in.fire() {
            // stop (released) ++ odd parity ++ data, bit 0 sent first
            tx_sh = 1u1 ++ ((!(^in.data)) as uint<1>) ++ in.data
            clk_oe_q = true
            timer = 0
            state = .TxInhibit
        }
    }

    /// The host leaves both lines to the device while receiving.
    property releases_lines_in_rx { always state == .Rx |-> !ps2_clk_oe and !ps2_data_oe }
    /// The inhibit phase holds CLK low.
    property inhibit_holds_clock { always state == .TxInhibit |-> ps2_clk_oe }
    /// A byte and an error never appear together.
    property out_or_error { never out.valid and error }
}

test "Ps2 receives a scan code" {
    let dut = sim Ps2<1_000_000>()                  // 1 cycle = 1 us
    dut.reset()
    dut.in.valid = false
    dut.ps2_clk_i = true
    dut.ps2_data_i = true
    dut.step(10)
    let byte: u8 = 0x1C                              // 'A' make code, 3 ones: parity bit 0
    let frame: bit<11> = 1u1 ++ ((!(^byte)) as uint<1>) ++ byte ++ 0u1
    var got = false
    var err = false
    var data: u8 = 0
    for i in 0..11 {
        dut.ps2_data_i = frame[i]
        dut.step(20)
        dut.ps2_clk_i = false                        // device: falling edge, host samples
        for _ in 0..40 {
            dut.step()
            if dut.out.valid { got = true; data = dut.out.data }
            if dut.error { err = true }
        }
        dut.ps2_clk_i = true
        dut.step(20)
    }
    expect got and data == 0x1C and !err
}

test "Ps2 flags a parity error" {
    let dut = sim Ps2<1_000_000>()
    dut.reset()
    dut.in.valid = false
    dut.ps2_clk_i = true
    dut.ps2_data_i = true
    dut.step(10)
    let byte: u8 = 0x1C
    let frame: bit<11> = 1u1 ++ ((^byte) as uint<1>) ++ byte ++ 0u1     // wrong parity
    var got = false
    var err = false
    for i in 0..11 {
        dut.ps2_data_i = frame[i]
        dut.step(20)
        dut.ps2_clk_i = false
        for _ in 0..40 {
            dut.step()
            if dut.out.valid { got = true }
            if dut.error { err = true }
        }
        dut.ps2_clk_i = true
        dut.step(20)
    }
    expect err and !got
}

test "Ps2 discards a partial frame after a gap" {
    let dut = sim Ps2<1_000_000>()
    dut.reset()
    dut.in.valid = false
    dut.ps2_clk_i = true
    dut.ps2_data_i = true
    dut.step(10)
    for _ in 0..4 {                                  // a truncated frame: 4 clocks
        dut.ps2_data_i = false
        dut.step(20)
        dut.ps2_clk_i = false
        dut.step(40)
        dut.ps2_clk_i = true
        dut.step(20)
    }
    dut.ps2_data_i = true
    dut.step(2_000)
    let byte: u8 = 0xF0                              // break prefix, 4 ones: parity bit 1
    let frame: bit<11> = 1u1 ++ ((!(^byte)) as uint<1>) ++ byte ++ 0u1
    var got = false
    var err = false
    var data: u8 = 0
    for i in 0..11 {
        dut.ps2_data_i = frame[i]
        dut.step(20)
        dut.ps2_clk_i = false
        for _ in 0..40 {
            dut.step()
            if dut.out.valid { got = true; data = dut.out.data }
            if dut.error { err = true }
        }
        dut.ps2_clk_i = true
        dut.step(20)
    }
    expect got and data == 0xF0 and !err
}

test "Ps2 sends a byte to the device and reads its ACK" {
    let dut = sim Ps2<1_000_000>()
    dut.reset()
    dut.ps2_clk_i = true
    dut.ps2_data_i = true
    dut.step(10)
    dut.in = Stream { valid: true, data: 0xED }      // set LEDs: 6 ones, parity bit 1
    dut.step()
    dut.in.valid = false
    expect dut.tx_busy and dut.ps2_clk_oe
    dut.step_until(!dut.ps2_clk_oe, max: 500)
    expect dut.ps2_data_oe                           // request to send: DATA low, CLK released
    // device: generates 11 clocks, reads DATA while CLK is high
    var bits: u16 = 0
    var mask: u16 = 1
    for i in 0..11 {
        dut.ps2_clk_i = false
        if i == 10 { dut.ps2_data_i = false }        // ACK during the 11th clock
        dut.step(40)
        dut.ps2_clk_i = true
        dut.step(20)
        if i < 10 and !dut.ps2_data_oe { bits = bits | mask }
        mask = mask << 1
        dut.step(20)
    }
    dut.ps2_data_i = true
    dut.step(20)
    expect (bits & 0xFF) == 0xED
    expect bits[8]                                   // odd parity
    expect bits[9]                                   // stop bit: DATA released
    expect !dut.tx_busy and dut.tx_ack
    expect !dut.ps2_clk_oe and !dut.ps2_data_oe
}

test "Ps2 abandons a transfer when the device never clocks" {
    let dut = sim Ps2<1_000_000>()
    dut.reset()
    dut.ps2_clk_i = true
    dut.ps2_data_i = true
    dut.in = Stream { valid: true, data: 0xFF }
    dut.step()
    dut.in.valid = false
    dut.step_until(!dut.tx_busy, max: 25_000)
    expect !dut.tx_ack
    expect !dut.ps2_clk_oe and !dut.ps2_data_oe
}

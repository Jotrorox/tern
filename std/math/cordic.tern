package std::math

// ---------------------------------------------------------------------------
// Compile-time helpers for CORDIC tables (exact integer arithmetic; no
// floating point is needed at elaboration time)
// ---------------------------------------------------------------------------

/// Integer square root (floor) of a compile-time integer, by Newton's method.
pub const fn isqrt(n: uint) -> uint {
    if n < 2 {
        n
    } else {
        var x: uint = n
        var y: uint = (x + 1) / 2
        while y < x {
            x = y
            y = (x + n / x) / 2
        }
        x
    }
}

/// atan(1/n) scaled by 2^p, from the Taylor series (n >= 2).
pub const fn atan_inv_fp(n: uint, p: uint) -> uint {
    var pw: uint = (1 << p) / n
    var sum: uint = pw
    var k: uint = 1
    var neg: bool = true
    while pw > 0 {
        pw = pw / (n * n)
        let t = pw / (2 * k + 1)
        if neg { sum = sum - t } else { sum = sum + t }
        neg = !neg
        k = k + 1
    }
    sum
}

/// atanh(1/n) scaled by 2^p, from the Taylor series (n >= 2).
pub const fn atanh_inv_fp(n: uint, p: uint) -> uint {
    var pw: uint = (1 << p) / n
    var sum: uint = pw
    var k: uint = 1
    while pw > 0 {
        pw = pw / (n * n)
        sum = sum + pw / (2 * k + 1)
        k = k + 1
    }
    sum
}

/// pi scaled by 2^p (Machin's formula).
pub const fn pi_fp(p: uint) -> uint {
    16 * atan_inv_fp(5, p) - 4 * atan_inv_fp(239, p)
}

/// atan(2^-i) as a binary angle of `w` bits (a full turn is 2^w), rounded.
pub const fn cordic_atan(i: uint, w: uint) -> uint {
    if i == 0 {
        1 << (w - 3)                       // pi/4 is exactly 1/8 turn
    } else {
        let p = w + 32
        let a = atan_inv_fp(1 << i, p)
        let pi = pi_fp(p)
        (a * (1 << w) + pi) / (2 * pi)
    }
}

/// atanh(2^-i) in fixed point with `w - 2` fraction bits, rounded (i >= 1).
pub const fn cordic_atanh(i: uint, w: uint) -> uint {
    (atanh_inv_fp(1 << i, w + 32) + (1 << 33)) >> 34
}

/// Shift amount of the k-th hyperbolic CORDIC iteration: 1, 2, 3, 4, 4, 5,
/// ..., 13, 13, ..., 40, 40, ... (iterations 4, 13, 40, ... are repeated
/// for convergence).
pub const fn cordic_hyp_index(k: uint) -> uint {
    var i: uint = 1
    var rep: uint = 4
    var repeated: bool = false
    var j: uint = 0
    while j < k {
        if i == rep and !repeated {
            repeated = true
        } else {
            if i == rep {
                rep = 3 * rep + 1
                repeated = false
            }
            i = i + 1
        }
        j = j + 1
    }
    i
}

/// round(2^(w-2) / gain) for `iters` CORDIC iterations: the start value of
/// `x` that makes the outputs come out at a scale of 2^(w-2).
pub const fn cordic_gain_comp(w: uint, iters: uint, hyperbolic: bool) -> uint {
    let p = w + 32
    var g: uint = 1 << p
    for k in 0..iters {
        let i = if hyperbolic { cordic_hyp_index(k) } else { k }
        let d = if hyperbolic {
            (1 << (2 * p)) - (1 << (2 * p - 2 * i))
        } else {
            (1 << (2 * p)) + (1 << (2 * p - 2 * i))
        }
        g = g * (1 << p) / isqrt(d)
    }
    let sh = p - (w - 2)
    (g + (1 << (sh - 1))) >> sh
}

// ---------------------------------------------------------------------------
// Cordic
// ---------------------------------------------------------------------------

/// What a `Cordic` computes.
pub enum CordicMode {
    /// Rotate (x, y) by the angle z: with x = GAIN_COMP, y = 0 the outputs
    /// are cos(z) and sin(z) at a scale of 2^(W-2).
    Rotate,
    /// Rotate (x, y) onto the positive x axis: x becomes the magnitude times
    /// the CORDIC gain (about 1.6468) and z accumulates atan2(y, x).
    Vector,
    /// Hyperbolic rotation by z: with x = GAIN_COMP, y = 0 the outputs are
    /// cosh(z) and sinh(z) at a scale of 2^(W-2) (and x + y = exp(z)).
    Hyperbolic,
}

/// The three CORDIC registers.
pub struct CordicData<W: uint> {
    /// x coordinate.
    x: sint<W>,
    /// y coordinate.
    y: sint<W>,
    /// Angle: in `.Rotate`/`.Vector` a binary angle (a full turn is 2^W, so
    /// the range is [-pi, pi)); in `.Hyperbolic` a fixed-point value with
    /// W - 2 fraction bits.
    z: sint<W>,
}

/// Fully pipelined CORDIC with W iterations, one result per cycle.
///
/// * `.Rotate`: any angle (inputs outside +-pi/2 are pre-rotated by pi).
///   Keep |x|, |y| <= 2^(W-2) / 1.65 (GAIN_COMP is the largest useful x).
/// * `.Vector`: any quadrant (x < 0 is pre-rotated by pi); keep |x|, |y| <
///   2^(W-3) so the gain-scaled magnitude fits. z must start at 0 (or at an
///   offset to add to the angle).
/// * `.Hyperbolic`: |z| <= 1.1 (in units of 2^(W-2)).
///
/// The datapath carries two guard bits; results are accurate to a few LSB.
pub module Cordic<W: uint = 16, Mode: CordicMode = .Rotate>
where W >= 8
{
    /// Clock.
    in clk: clock
    /// Reset; clears the valid pipeline.
    in rst: reset
    /// Start values.
    in in: Valid<CordicData<W>>
    /// Results, LATENCY cycles later.
    out out: Valid<CordicData<W>>

    /// Number of iterations (one pipeline stage each).
    pub const ITERS: uint = W
    /// Cycles from `in` to `out`.
    pub const LATENCY: uint = W
    /// x start value that cancels the CORDIC gain (rotation modes).
    pub const GAIN_COMP: uint = cordic_gain_comp(W, W, Mode == .Hyperbolic)

    const IW: uint = W + 2

    struct St {
        x: sint<IW>,
        y: sint<IW>,
        z: sint<W>,
    }

    // pre-rotation by pi into the convergence range (circular modes)
    let x0 = in.data.x as sint<IW>
    let y0 = in.data.y as sint<IW>
    let z0 = in.data.z
    let z_plus_pi = (bits(z0) ^ ((1 << (W - 1)) as bit<W>)) as sint<W>
    let pre_rotate = if Mode == .Rotate {
        bits(z0)[W - 1] != bits(z0)[W - 2]
    } else if Mode == .Vector {
        x0 < 0
    } else {
        false
    }

    var v: [bool; W + 1]
    var s: [St; W + 1]
    v[0] = in.valid
    s[0] = if pre_rotate {
        St { x: (-x0) as sint<IW>, y: (-y0) as sint<IW>, z: z_plus_pi }
    } else {
        St { x: x0, y: y0, z: z0 }
    }

    for k in 0..W {
        let i = if Mode == .Hyperbolic { cordic_hyp_index(k) } else { k }
        let ang = (if Mode == .Hyperbolic { cordic_atanh(i, W) } else { cordic_atan(i, W) }) as sint<W>
        let cur = s[k]
        let xs = cur.x >>> i
        let ys = cur.y >>> i
        let pos = if Mode == .Vector { cur.y < 0 } else { cur.z >= 0 }
        let nxt = if Mode == .Hyperbolic {
            if pos {
                St { x: cur.x +% ys, y: cur.y +% xs, z: cur.z -% ang }
            } else {
                St { x: cur.x -% ys, y: cur.y -% xs, z: cur.z +% ang }
            }
        } else {
            if pos {
                St { x: cur.x -% ys, y: cur.y +% xs, z: cur.z -% ang }
            } else {
                St { x: cur.x +% ys, y: cur.y -% xs, z: cur.z +% ang }
            }
        }
        reg rv: bool = false
        reg rs: St
        on clk {
            rv = v[k]
            rs = nxt
        }
        v[k + 1] = rv
        s[k + 1] = rs
    }

    out.valid = v[W]
    out.data = CordicData { x: s[W].x as sint<W>, y: s[W].y as sint<W>, z: s[W].z }

    /// Every input yields exactly one result, LATENCY cycles later.
    property fixed_latency {
        always out.valid == past(in.valid, W)
    }
}

test "cordic tables" {
    expect cordic_atan(0, 16) == 8192
    expect cordic_atan(1, 16) == 4836
    expect cordic_atan(2, 16) == 2555
    expect cordic_atanh(1, 16) == 9000
    expect cordic_hyp_index(3) == 4
    expect cordic_hyp_index(4) == 4
    expect cordic_hyp_index(5) == 5
    expect cordic_hyp_index(14) == 13
    expect cordic_gain_comp(16, 16, false) == 9949
    expect isqrt(1_000_000) == 1000
    expect Cordic<16>::GAIN_COMP == 9949
}

test "cordic rotate: cos and sin" {
    let dut = sim Cordic<16, .Rotate>()
    dut.reset()
    // (angle as a 16-bit binary angle, cos * 2^14, sin * 2^14)
    for (z, c, s) in [(5461, 14189, 8192), (21845, -8192, 14189), (32767, -16384, 0),
                      (-10923, 8192, -14189), (0, 16384, 0)] {
        dut.in = Valid { valid: true, data: CordicData { x: 9949, y: 0, z: z } }
        dut.step()
        dut.in.valid = false
        dut.step(15)
        expect dut.out.valid
        expect dut.out.data.x >= c - 8 and dut.out.data.x <= c + 8
        expect dut.out.data.y >= s - 8 and dut.out.data.y <= s + 8
    }
}

test "cordic vector: magnitude and atan2 in every quadrant" {
    let dut = sim Cordic<16, .Vector>()
    dut.reset()
    // (x, y, gain * |v|, atan2 as a binary angle)
    for (x, y, m, a) in [(3000, 4000, 8234, 9672), (-3000, 4000, 8234, 23096),
                         (4000, -3000, 8234, -6712), (-4000, -3000, 8234, -26056)] {
        dut.in = Valid { valid: true, data: CordicData { x: x, y: y, z: 0 } }
        dut.step()
        dut.in.valid = false
        dut.step(15)
        expect dut.out.valid
        expect dut.out.data.x >= m - 8 and dut.out.data.x <= m + 8
        expect dut.out.data.z >= a - 8 and dut.out.data.z <= a + 8
    }
}

test "cordic hyperbolic: cosh and sinh" {
    let dut = sim Cordic<16, .Hyperbolic>()
    dut.reset()
    expect Cordic<16, .Hyperbolic>::GAIN_COMP == 19784
    // z = 0.5 in Q2.14 -> cosh = 1.1276, sinh = 0.5211
    dut.in = Valid { valid: true, data: CordicData { x: 19784, y: 0, z: 8192 } }
    dut.step()
    dut.in.valid = false
    dut.step(15)
    expect dut.out.valid
    expect dut.out.data.x >= 18475 - 8 and dut.out.data.x <= 18475 + 8
    expect dut.out.data.y >= 8538 - 8 and dut.out.data.y <= 8538 + 8
}

test "cordic: one result per cycle" {
    let dut = sim Cordic<12>()
    dut.reset()
    dut.in = Valid { valid: true, data: CordicData { x: 100, y: 0, z: 0 } }
    dut.step(12)
    for _ in 0..10 {
        expect dut.out.valid
        dut.step()
    }
}

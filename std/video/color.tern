package std::video

/// 24-bit RGB pixel, 8 bits per channel. Packed as `r ++ g ++ b`
/// (`bits(c)` is the usual 0xRRGGBB).
pub struct Rgb888 {
    r: u8,
    g: u8,
    b: u8,
}

/// 16-bit RGB pixel, 5-6-5 bits. Packed as `r ++ g ++ b`, so `bits(c)` is
/// the standard RGB565 word and `Rgb565::from_bits(w)` unpacks one.
pub struct Rgb565 {
    r: uint<5>,
    g: uint<6>,
    b: uint<5>,
}

/// Converts RGB888 to RGB565 by dropping the low bits of each channel.
pub fn rgb888_to_565(c: Rgb888) -> Rgb565 {
    Rgb565 { r: c.r[7:3], g: c.g[7:2], b: c.b[7:3] }
}

/// Scales an 8-bit channel to the nearest of the 2^N levels of an N-bit
/// channel: round(v · (2^N - 1) / 255). (Division by a constant.)
fn round_channel<N: uint>(v: u8) -> uint<N> {
    ((v * ((1 << N) - 1) + 127) / 255) as uint<N>
}

/// Converts RGB888 to RGB565 rounding each channel to the nearest level
/// (round(v · 31 / 255) and round(v · 63 / 255)); the inverse of
/// [rgb565_to_888] up to rounding, so a 565 -> 888 -> 565 round trip is exact.
pub fn rgb888_to_565_round(c: Rgb888) -> Rgb565 {
    Rgb565 { r: round_channel<5>(c.r), g: round_channel<6>(c.g), b: round_channel<5>(c.b) }
}

/// Expands RGB565 to RGB888 by bit replication (the top bits repeat in the
/// low bits), so 0 maps to 0 and full scale maps to 255.
pub fn rgb565_to_888(c: Rgb565) -> Rgb888 {
    Rgb888 { r: c.r ++ c.r[4:2], g: c.g ++ c.g[5:4], b: c.b ++ c.b[4:2] }
}

/// Builds an RGB888 pixel from a 0xRRGGBB word.
pub fn rgb888_from_hex(v: uint<24>) -> Rgb888 {
    Rgb888::from_bits(v)
}

/// Luma (BT.601, integer approximation): (77·R + 150·G + 29·B) / 256.
pub fn luma(c: Rgb888) -> u8 {
    ((c.r * 77 + c.g * 150 + c.b * 29) >> 8) as u8
}

test "888 to 565 truncates" {
    let c = rgb888_to_565(Rgb888 { r: 0xFF, g: 0x80, b: 0x07 })
    expect c.r == 31 and c.g == 32 and c.b == 0
    expect bits(rgb888_to_565(Rgb888 { r: 0xFF, g: 0xFF, b: 0xFF })) == 0xFFFF
}

test "888 to 565 rounding picks the nearest level" {
    let c = rgb888_to_565_round(Rgb888 { r: 0xFF, g: 0x81, b: 0x05 })
    expect c.r == 31          // full scale stays full scale
    expect c.g == 32          // 129 · 63 / 255 = 31.9
    expect c.b == 1           // 5 · 31 / 255 = 0.61
    expect rgb888_to_565_round(Rgb888 { r: 4, g: 0, b: 0 }).r == 0   // 0.49 rounds down
}

test "565 to 888 replicates bits" {
    let w = rgb565_to_888(Rgb565 { r: 31, g: 63, b: 31 })
    expect w.r == 255 and w.g == 255 and w.b == 255
    let k = rgb565_to_888(Rgb565 { r: 0, g: 0, b: 0 })
    expect k.r == 0 and k.g == 0 and k.b == 0
    let m = rgb565_to_888(Rgb565 { r: 0b10000, g: 0b100000, b: 0b00001 })
    expect m.r == 0b1000_0100 and m.g == 0b1000_0010 and m.b == 0b0000_1000
}

test "565 round trip is lossless" {
    for _ in 0..256 {
        let c = Rgb565::from_bits(rand<u16>())
        expect bits(rgb888_to_565(rgb565_to_888(c))) == bits(c)
        expect bits(rgb888_to_565_round(rgb565_to_888(c))) == bits(c)
    }
}

test "packing order is r g b from the top" {
    let c = rgb888_from_hex(0x123456)
    expect c.r == 0x12 and c.g == 0x34 and c.b == 0x56
    expect bits(Rgb565 { r: 1, g: 0, b: 0 }) == 0x0800
}

test "luma of grey levels" {
    expect luma(Rgb888 { r: 0, g: 0, b: 0 }) == 0
    expect luma(Rgb888 { r: 255, g: 255, b: 255 }) == 255
    expect luma(Rgb888 { r: 100, g: 100, b: 100 }) == 100
}

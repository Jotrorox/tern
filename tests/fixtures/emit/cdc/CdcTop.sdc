# CdcTop.sdc: timing constraints for CdcTop, generated by tern. Do not edit.

# clocks
create_clock -name sys_clk -period 10.000 [get_ports {sys_clk}]
create_clock -name pix_clk -period 40.000 [get_ports {pix_clk}]

# CDC CdcTop > u_sync: Sync2<bool> (sync2)
# synchronizer registers (Quartus: SYNCHRONIZER_IDENTIFICATION in the .qsf): u_sync|s1 u_sync|s2
set_false_path -to [get_registers {u_sync|s1}]

# CDC CdcTop > u_xfer: GrayXfer<8> (async_fifo)
# synchronizer registers (Quartus: SYNCHRONIZER_IDENTIFICATION in the .qsf): u_xfer|wq1_rgray[*] u_xfer|wq2_rgray[*] u_xfer|rq1_wgray[*] u_xfer|rq2_wgray[*]
set_max_delay -from [get_registers {u_xfer|rgray[*]}] -to [get_registers {u_xfer|wq1_rgray[*]}] 10.000
set_max_delay -from [get_registers {u_xfer|wgray[*]}] -to [get_registers {u_xfer|rq1_wgray[*]}] 40.000
set_max_delay -from [get_registers {u_xfer|mem*}] -to [get_registers {u_xfer|odata[*]}] 40.000

# CDC report
#   CdcTop > u_sync: sync2, sys -> pix, signal flag (src/demo.tern:581)
#   CdcTop > u_xfer: async_fifo, sys -> pix, signal din (src/demo.tern:582)
#   CdcTop: unsafe, sys -> pix, signal cfg (src/demo.tern:577)

# CdcTop.xdc: timing constraints for CdcTop, generated by tern. Do not edit.

# clocks
create_clock -name sys_clk -period 10.000 [get_ports {sys_clk}]
create_clock -name pix_clk -period 40.000 [get_ports {pix_clk}]

# CDC CdcTop > u_sync: Sync2<bool> (sync2)
set_property ASYNC_REG TRUE [get_cells {u_sync/s1_reg u_sync/s2_reg}]
set_false_path -to [get_cells {u_sync/s1_reg}]

# CDC CdcTop > u_xfer: GrayXfer<8> (async_fifo)
set_property ASYNC_REG TRUE [get_cells {u_xfer/wq1_rgray_reg[*] u_xfer/wq2_rgray_reg[*] u_xfer/rq1_wgray_reg[*] u_xfer/rq2_wgray_reg[*]}]
set_max_delay -datapath_only -from [get_cells {u_xfer/rgray_reg[*]}] -to [get_cells {u_xfer/wq1_rgray_reg[*]}] 10.000
set_max_delay -datapath_only -from [get_cells {u_xfer/wgray_reg[*]}] -to [get_cells {u_xfer/rq1_wgray_reg[*]}] 40.000
set_max_delay -datapath_only -from [get_cells {u_xfer/mem_reg*}] -to [get_cells {u_xfer/odata_reg[*]}] 40.000

# CDC report
#   CdcTop > u_sync: sync2, sys -> pix, signal flag (src/demo.tern:581)
#   CdcTop > u_xfer: async_fifo, sys -> pix, signal din (src/demo.tern:582)
#   CdcTop: unsafe, sys -> pix, signal cfg (src/demo.tern:577)

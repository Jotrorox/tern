// Table 3.2 precedence, all binary operators left-associative.
const A: uint = 1 + 2 * 3
const B: uint = a << 1 + 2
const C: uint = a & b ^ c | d
const D: bool = a ++ b == c ++ d
const E: bool = a == b and c != d or e < f
const F: bool = a xor b and c or d
const G: u8 = -x as u8
const H: bool = !a.b[3]
const I: bool = &x | |y ^ ^z
const J: u8 = a +% b -% c - d + e
const K: u8 = x >>> 2 >> 1 << 3
const L: bool = a && b || !c
const M: bool = x in [.A, .B] and y
const N: u8 = a / b % c * d
const O: u8 = ~x[7:0]
const P: u8 = x.trunc<8>()
const Q: bool = a <= b and c >= d and e > f
const R: u8 = (a + b)[8:1]
const S: uint = 0..10
const T: uint = 0..=10
const U: bool = not not a
const V: u8 = f(x)(y)[0].z

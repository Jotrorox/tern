(file
  (module@2:1 Props (generics (N uint))
    (in@3:5 a bool)
    (in@4:5 b bool)
    (in@5:5 s State)
    (property@7:5 p1 (always (|=> (## 1 a b) (not a))))
    (property@8:5 p2 (always (|=> (paren (## 1 a (paren (and (not a) b)))) (call stable s))))
    (property@9:5 p3 (## N a b))
    (property@10:5 p4 (##[1:3] (## (paren (+ N 1)) a b) a))
    (property@11:5 p5 (## 1 _ a))
    (property@12:5 p6 (always (|-> (not (call stable s)) (== (call past s) .Idle))))
    (property@13:5 p7 (always (|-> a (eventually ..N b))))
    (property@14:5 p8 (never (and a b)))
    (property@15:5 p9 (always (until a b)))
    (property@16:5 p10 (always (|-> a (|=> b a))))
    (property@18:5 p11 (doc "A documented property.") (always (|=> (paren (and a b)) (or a b))))
    (property@23:5 c1 cover (##[1:$] a b))
    (sequence@24:5 seq1 (## 1 a b))
    (expr@25:5 (if (> N 1) (block
      (property@26:9 in_if (always (|-> a b))))))
    (for@28:5 i (.. 0 N) (block
      (property@29:9 in_for assert (always (|-> a b)))))
    (let@32:5 always = a)
    (let@33:5 never = (and always b))
    (let@34:5 eventually = (call until never)))
  (comments 3))

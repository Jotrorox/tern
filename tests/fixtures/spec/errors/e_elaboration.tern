// Errors the spec describes that elaboration reports (one per line below).
module Widths {
    in clk: clock
    in rst: reset
    in a: [u8; 16]
    in i5: uint<5>
    in b1: bool
    in b2: bool
    in u: u8
    in s: s8
    in wide: u16
    out q: uint<4>

    reg tick: uint<4> = 0
    on clk { tick = tick + 1 } // §2: one bit wider, rejected when assigned back
    q = tick
    let k = a[16] // §5.5: out-of-range constant index
    let d = a[i5] // §5.5: the index must be exactly wide enough
    let n = b1 + b2 // §5.2: bool is not an integer
    let m = u + s // §5.3: mixing uint and sint
    let x = u / u // table 5.2: division by a signal needs std::math::Divider
    let y: u8 = wide // §5.3: no silent narrowing
    let r = rst as bool // §6.4: reset is never read as data
}

module TwoClocks {
    in clk_a: clock
    in clk_b: clock
    reg x: u8 = 0 // §6.3: two clock ports, every reg must say `@ which`
}

module Leaf {
    in clk: clock
    in d: u8
    out q: u8
    q = d
}

pub module Fifo<Depth: uint = 16>
where Depth.is_pow2()
{
    in clk: clock
}

const fn count_up(x: u8) -> u8 {
    var n: u8 = 0
    while n < x { n = n +% 1 } // §9.2: `while` only at compile time
    n
}

module Memories {
    in clk: clock
    in a: uint<10>
    in d: u32
    out q: u32
    out c: u8
    mem buf: [u32; 1024]
    let r1 = buf.read(a)
    let r2 = buf.read(a +% 1)
    let r3 = buf.read(a +% 2) // §10.1: three read ports
    on clk { buf = d } // §10.1: no whole-value assignment
    q = r1 ^ r2 ^ r3
    c = count_up(d as u8)
}

module NotTop {
    in pad: tri<bool> // §7.5: only a #[top] may have tri<T> ports
}

module Top {
    in clk: clock
    in rst: reset
    in a: [u8; 16]
    in d: u8

    static_assert(1 + 1 == 3, "arithmetic is broken") // §9.3
    let w = Widths(a, i5: 0, b1: true, b2: false, u: d, s: 0, wide: 0)
    let t = TwoClocks(clk_a: clk, clk_b: clk)
    let l = Leaf() // §7.2: an unconnected input is an error
    let f = Fifo<6>() // §7.1: the `where` error points at the instantiation
    let m = Memories(a: 0, d: 0)
}

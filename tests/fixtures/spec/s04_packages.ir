  15: reg wr_vis: uint<3> @0 = 3'h0
  16: wire used: uint<3>
  17: wire rd_next: uint<3>
  18: reg buf_rd0: uint<8> @0
  assign used = (wr_ptr - rd_ptr)
  assign full = (used == 3'h4)
  assign empty = (used == 3'h0)
  assign count = used
  assign almost_full = (used >= 3'h3)
  assign push_ready = !full
  assign pop_valid = (rd_ptr != wr_vis)
  assign rd_next = ((pop_valid && pop_ready) ? (rd_ptr + 3'h1) : rd_ptr)
  assign pop_data = buf_rd0
  on 0 regs(buf_rd0) {
    buf_rd0 = buf[zext2(rd_next)]
  }
  on 0 regs(wr_ptr, rd_ptr, wr_vis) {
    if (push_valid && push_ready) {
      buf[zext2(wr_ptr)] = push_data
      wr_ptr = (wr_ptr + 3'h1)
    }
    wr_vis = wr_ptr
    rd_ptr = rd_next
  }
  assert property count_bounded @0: always (count <= 3'h4)
  assert property visible_within_used @0: always ((wr_vis - rd_ptr) <= used)
  assert property pop_stable @0: always ((pop_valid && !pop_ready) |=> (pop_valid && (pop_data == past(pop_data, 1))))
  cover property fills_up @0: full
  cover property wraps_around @0: (full ##[1:$] empty)

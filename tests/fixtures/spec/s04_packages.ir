module Fifo_u8_4_3 "Fifo<uint<8>, 4, 3>" in std::fifo
  param Depth = 32'h4
  param AlmostFull = 32'h3
  domain 0 "" clock=clk reset=rst default
  0: in clk: clock
  1: in rst: reset<sync, high> @0

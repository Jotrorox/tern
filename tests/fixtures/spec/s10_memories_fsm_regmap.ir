enum Event (2 bits, tag 2, binary) { None = 2'h0, Start = 2'h1, Done = 2'h2, Abort = 2'h3 }
enum State (2 bits, tag 2, binary) { Idle = 2'h0, Run = 2'h1, Finish = 2'h2 }
enum Mode (2 bits, tag 2, binary) { Off = 2'h0, Slow = 2'h1, Fast = 2'h2, Turbo = 2'h3 }
struct Ctrl_Ctrl (3 bits) { mode: Mode @1, enable: bool @0 }
struct Ctrl_Status (2 bits) { err: bool @1, busy: bool @0 }
struct RegReq_32_32 (69 bits) { addr: uint<32> @37, wdata: uint<32> @5, strb: bit<4> @1, write: bool @0 }
struct RegRsp_32 (34 bits) { rdata: uint<32> @2, resp: bit<2> @0 }
module Fsm
  domain 0 "" clock=clk reset=rst default
  0: in clk: clock
  1: in rst: reset<sync, high> @0
  2: in event: Event @0
  3: out is_busy: bool @0
  4: reg state: State @0 = 2'h0
  5: wire busy: bool
  assign busy = ((state == 2'h1) || (state == 2'h2))
  assign is_busy = busy
  on 0 regs(state) {
    state = (((state == 2'h0) && (event == 2'h1)) ? 2'h1 : (((state == 2'h1) && (event == 2'h2)) ? 2'h2 : (((state == 2'h1) && (event == 2'h3)) ? 2'h0 : ((state == 2'h2) ? 2'h0 : state))))
  }
end
module Mems
  domain 0 "" clock=clk reset=none default
  0: in clk: clock
  1: in we: bool @0
  2: in wr_addr: uint<10> @0
  3: in wr_data: uint<32> @0
  4: in mask_we: bool @0
  5: in mask: bit<4> @0
  6: in rd_addr: uint<10> @0
  7: in idx: uint<6> @0
  8: out rd_q: uint<32> @0
  9: out old_q: uint<32> @0
  10: out lut_q: uint<8> @0
  11: mem buf: uint<32> x 1024
  12: mem lut: uint<8> x 64 mem_init include_hex("sine.hex") #[ram(distributed)]
  13: reg buf_rd0: uint<32> @0
  14: wire rd: uint<32>
  15: reg buf_rd1: uint<32> @0
  16: wire old: uint<32>
  17: wire async_rd: uint<8>
  assign rd = buf_rd0
  assign old = buf_rd1
  assign async_rd = lut[idx]
  assign rd_q = rd
  assign old_q = old
  assign lut_q = async_rd
  on 0 regs(buf_rd0) {
    buf_rd0 = buf[rd_addr]
  }
  on 0 regs(buf_rd1) {
    buf_rd1 = buf[rd_addr]
  }
  on 0 regs() {
    if we {
      buf[wr_addr] = wr_data
    }
    if mask_we {
      buf[wr_addr] = wr_data mask mask
    }
  }
end

module Engine
  domain 0 "" clock=clk reset=rst default
  0: in clk: clock
  1: in rst: reset<sync, high> @0
  2: in enable: bool @0
  3: in mode: Mode @0
  4: in in_valid (in.valid): bool @0
  5: in in_data (in.data): uint<8> @0
  6: out in_ready (in.ready): bool @0 flipped
  7: out busy: bool @0
  8: out err: bool @0
  9: reg n: uint<8> @0 = 8'h0
  assign in_ready = enable
  assign busy = ((n != 8'h0) && (mode != 2'h0))
  assign err = 1'h0
  on 0 regs(n) {
    if (in_valid && in_ready) {
      n = (n + 8'h1)
    }
  }
end

enum UartRxCore_6_State (2 bits, tag 2, binary) { Idle = 2'h0, Start = 2'h1, Data = 2'h2, Stop = 2'h3 }
module UartRxCore_6 "UartRxCore<6>" in std::io
  param DivW = 32'h6
  domain 0 "" clock=clk reset=rst default
  0: in clk: clock
  1: in rst: reset<sync, high> @0

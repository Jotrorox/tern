  10: reg ovalid: bool @0 = 1'h0
  11: reg odata: bit<32> @0
  12: wire last_lane: bool
  assign last_lane = (cnt == 2'h3)
  assign in_ready = ((!last_lane || !ovalid) || out_ready)
  assign out_valid = ovalid
  assign out_data = zext32(odata)
  on 0 regs(acc, cnt, ovalid, odata) {
    if (out_valid && out_ready) {
      ovalid = 1'h0
    }
    if (in_valid && in_ready) {
      if last_lane {
        odata = {in_data, acc[8+:24]}
        ovalid = 1'h1
        cnt = 2'h0
      } else {
        acc = {in_data, acc[8+:24]}
        cnt = (cnt + 2'h1)
      }
    }
  }
  assert property out_stable @0: always ((out_valid && !out_ready) |=> (out_valid && (out_data == past(out_data, 1))))

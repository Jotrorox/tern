  8: out overrun: bool @0
  9: reg s1: bool @0 = 1'h1
  10: reg s2: bool @0 = 1'h1
  11: reg s3: bool @0 = 1'h1
  12: wire line: bool
  13: wire fall: bool
  14: reg state: UartRxCore_6_State @0 = 2'h0
  15: reg div_q: uint<6> @0 = 6'h4
  16: reg tick: uint<6> @0 = 6'h0
  17: reg bit_idx: uint<3> @0 = 3'h0
  18: reg shift: uint<8> @0 = 8'h0
  19: reg out_valid: bool @0 = 1'h0
  20: reg out_data: uint<8> @0 = 8'h0
  21: reg frame_error_q: bool @0 = 1'h0
  22: reg overrun_q: bool @0 = 1'h0
  23: wire baud_tick: bool
  assign line = s2
  assign fall = (s3 && !s2)
  assign baud_tick = (tick == 6'h0)
  assign out_valid = out_valid
  assign out_data = out_data
  assign frame_error = frame_error_q
  assign overrun = overrun_q
  on 0 regs(s1, s2, s3, state, div_q, tick, bit_idx, shift, out_valid, out_data, frame_error_q, overrun_q) {
    s1 = rxd
    s2 = s1
    s3 = s2
    frame_error_q = 1'h0
    overrun_q = 1'h0
    if (out_valid && out_ready) {
      out_valid = 1'h0
    }
    if (state != 2'h0) {
      tick = (baud_tick ? (div_q - 6'h1) : (tick - 6'h1))
    }
    case state {
      2'h0 => {
        if fall {
          div_q = divisor
          tick = ((divisor >> 3'h1) - 6'h1)
          state = 2'h1
        }
      }
      2'h1 => {
        if baud_tick {
          state = (line ? 2'h0 : 2'h2)
          bit_idx = 3'h0
        }
      }
      2'h2 => {
        if baud_tick {
          shift = {line, shift[1+:7]}
          bit_idx = (bit_idx + 3'h1)
          if (bit_idx == 3'h7) {
            state = 2'h3
          }
        }
      }
      2'h3 => {
        if baud_tick {
          state = 2'h0
          if !line {
            frame_error_q = 1'h1
          } else {
            if (out_valid && !out_ready) {
              overrun_q = 1'h1
            } else {
              out_valid = 1'h1
              out_data = shift
            }
          }
        }
      }
    }
  }
  assert property out_held @0: always ((out_valid && !out_ready) |=> (out_valid && (out_data == past(out_data, 1))))
  assert property frame_error_drops @0: never (frame_error && (out_valid && !past(out_valid, 1)))
end

// Appendix B: the Tern column of the SystemVerilog-to-Tern cheat sheet
// (`ifdef DEBUG -> cfg::debug is in cfg/s09_5_features.tern).
use std::math::widen_signed

enum T { A, B }

struct S { f: u8 }

bundle Bus {
    req: bool,
    flip ack: bool,
}

module Sub {
    in a: u8
    out y: u8
    y = a
}

#[top]
module M<W: uint = 8> {
    in clk: clock
    in rst: reset
    in a: u8
    in b: u8
    in c: bool
    in x: u8
    in d: u8
    in bus: Bus
    out y: u8
    out q_out: u8

    let w: u8 = a
    var v: u8
    reg r: u8 = 0
    reg q: u8 = 0
    let and_ab = a & b
    comb { v = a }
    on clk { r = a; q = d }
    y = match x { 0 => a, _ => b }
    let sel = if c { a } else { b }
    let cat = a ++ b
    let part = x[6:3]
    let lg = clog2(W)
    let zeros: u8 = all0
    let ones: u8 = all1
    let ff = 0xFFu8
    let ff2: u8 = 0xFF
    let wrap = a +% b
    let wide = a + b
    let sx = x as sint<9>
    let sw = widen_signed(x)
    var acc: u8
    comb {
        acc = 0
        for i in 0..W { acc = acc +% (x[i] as uint<1>) }
    }
    bus.ack = bus.req
    let m = Sub(a)
    let my = m.y
    mem ram: [u8; 256]
    on clk { ram[a] = b }
    let e = T::B
    let s = S { f: v }
    property p { always c |=> c or !c }
    q_out = q +% r +% my +% acc +% s.f +% ram[x]
}

test "..." {}

package simc_bench

// Benchmark design of build/test_simc (the compiled simulator): a 32-bit
// LFSR feeds eight CRC-32 lanes (std::crc::Crc32 over 32-bit words, each
// lane on a rotated copy of the word), whose results are folded by a
// three-stage xor/add pipeline into a 64-bit accumulator.

use std::crc::Crc32

pub module CrcBench {
    #[clock(hz: 100_000_000)]
    in clk: clock
    in rst: reset
    in en: bool
    in seed: u32
    out sig: u64

    reg lfsr: u32 = 1
    on clk {
        if en {
            let fb = lfsr[31] ^ lfsr[21] ^ lfsr[1] ^ lfsr[0]
            lfsr = (lfsr << 1 | fb as u32) ^ seed
        }
    }

    var crcs: [u32; 8]
    let c0 = Crc32<u32>(in: Stream { valid: en, data: lfsr }, clear: false)
    let c1 = Crc32<u32>(in: Stream { valid: en, data: lfsr >> 1 | lfsr << 31 }, clear: false)
    let c2 = Crc32<u32>(in: Stream { valid: en, data: lfsr >> 2 | lfsr << 30 }, clear: false)
    let c3 = Crc32<u32>(in: Stream { valid: en, data: lfsr >> 3 | lfsr << 29 }, clear: false)
    let c4 = Crc32<u32>(in: Stream { valid: en, data: lfsr >> 4 | lfsr << 28 }, clear: false)
    let c5 = Crc32<u32>(in: Stream { valid: en, data: lfsr >> 5 | lfsr << 27 }, clear: false)
    let c6 = Crc32<u32>(in: Stream { valid: en, data: lfsr >> 6 | lfsr << 26 }, clear: false)
    let c7 = Crc32<u32>(in: Stream { valid: en, data: lfsr >> 7 | lfsr << 25 }, clear: false)
    comb {
        crcs[0] = c0.crc
        crcs[1] = c1.crc
        crcs[2] = c2.crc
        crcs[3] = c3.crc
        crcs[4] = c4.crc
        crcs[5] = c5.crc
        crcs[6] = c6.crc
        crcs[7] = c7.crc
    }

    reg s1: [u32; 4] = all0
    reg s2: [u32; 2] = all0
    reg s3: u32 = 0
    reg acc: u64 = 0
    on clk {
        for i in 0..4 { s1[i] = crcs[2 * i] ^ (crcs[2 * i + 1] +% 0x9E37_79B9) }
        for i in 0..2 { s2[i] = (s1[2 * i] +% s1[2 * i + 1]) ^ (s1[2 * i] >> 3) }
        s3 = s2[0] ^ s2[1]
        acc = (acc << 5 | acc >> 59) +% s3 as u64
    }
    sig = acc
}
